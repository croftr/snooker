# Copy to .env.local to try things locally. None of this is needed for plain `npm run dev`,
# which uses data/local.json and lets you edit with any password.

# Password for "Referee mode" (editing). Required in production: without it all edits are refused.
SNOOKER_EDIT_PASSWORD=pick-something

# S3 (set these in Vercel too)
SNOOKER_S3_BUCKET=robs-booky-data
SNOOKER_AWS_REGION=eu-west-2
SNOOKER_AWS_ACCESS_KEY_ID=
SNOOKER_AWS_SECRET_ACCESS_KEY=

# Set to 1 to make `npm run dev` talk to the real S3 file rather than data/local.json
# FORCE_CLOUD=1
